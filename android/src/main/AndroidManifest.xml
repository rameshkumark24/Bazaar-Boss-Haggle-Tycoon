<?xml version="1.0" encoding="utf-8"?>
<!-- No permissions: v1 asks for none yet (PRD CR13). The allowlist guard arrives in M0. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- libGDX draws with OpenGL ES 2.0. -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!--
      appCategory="game": Android 16 keeps the portrait lock on large screens only for games (TRD [T11]).
      enableOnBackInvokedCallback: predictive back on Android 16, routed to libGDX (TRD [T4], PRD F15).
      Both are ignored by older Androids, which is intended (lint: UnusedAttribute).
    -->
    <application
        android:allowBackup="true"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        tools:ignore="UnusedAttribute">

        <!-- Portrait only is a PRD decision (F20); appCategory="game" keeps it on large screens. -->
        <activity
            android:name=".android.AndroidLauncher"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
