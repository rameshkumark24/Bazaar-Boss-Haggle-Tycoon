# Gradle and build output
.gradle/
build/

# This machine's Android SDK path (each machine writes its own)
local.properties

# IDE files. VS Code's Java tooling compiles into each module's bin/ folder.
.idea/
*.iml
.kotlin/
bin/
.project
.classpath
.settings/
.factorypath

# Signing keys never go in git (PRD CR11, TRD §11)
*.jks
*.keystore

# Screenshots taken while checking a build
/shots/

# Baked by tools at build time from content/ and the fonts; never edited or committed (LLD §1.2)
/assets/*
!/assets/.gitkeep
